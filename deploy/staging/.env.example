COMPOSE_PROJECT_NAME=ngv-odoo-mcp-staging
MCP_BIND_PORT=8765
MCP_PUBLIC_HOST=mcp-staging.example.com
MCP_RESOURCE_URL=https://mcp-staging.example.com/mcp
MCP_WRITE_BIND_PORT=8766
MCP_WRITE_PUBLIC_HOST=mcp-write-staging.example.com
MCP_WRITE_RESOURCE_URL=https://mcp-write-staging.example.com/mcp
MCP_AUTH_PUBLIC_HOST=auth-mcp-staging.example.com
MCP_AUTH_ISSUER_URL=https://auth-mcp-staging.example.com/realms/ngv-mcp-staging
MCP_AUTH_INTROSPECTION_URL=http://keycloak:8080/realms/ngv-mcp-staging/protocol/openid-connect/token/introspect
MCP_AUTH_TOKEN_URL=http://keycloak:8080/realms/ngv-mcp-staging/protocol/openid-connect/token
MCP_AUTH_REVOCATION_URL=http://keycloak:8080/realms/ngv-mcp-staging/protocol/openid-connect/revoke

{
  "version": 1,
  "clients": {
    "replace-with-oauth-subject-for-chatgpt": {
      "enabled": true,
      "instance": "odoo16-staging",
      "odoo_major": 16,
      "scopes": [
        "odoo.read",
        "odoo.crm.read",
        "odoo.customers.read",
        "odoo.sales.read",
        "odoo.products.read"
      ],
      "tools": [
        "ngv_whoami",
        "ngv_list_leads",
        "ngv_list_customers",
        "ngv_list_quotations",
        "ngv_list_products",
        "ngv_daily_sales_summary"
      ]
    },
    "replace-with-oauth-subject-for-sales-ai": {
      "enabled": true,
      "instance": "odoo16-staging",
      "odoo_major": 16,
      "scopes": ["odoo.read", "odoo.crm.read", "odoo.customers.read"],
      "tools": ["ngv_whoami", "ngv_list_leads", "ngv_list_customers"]
    }
  }
}

{
  "default": "odoo16-staging",
  "instances": {
    "odoo16-staging": {
      "url": "http://odoo16:8069",
      "db": "ngv_mcp_staging",
      "username": "mcp-readonly@example.invalid",
      "password": "replace-with-odoo-staging-api-key",
      "transport": "xmlrpc"
    },
    "odoo20-staging": {
      "url": "https://odoo20-staging.example.invalid",
      "db": "ngv_mcp_20_staging",
      "username": "mcp-readonly@example.invalid",
      "api_key": "replace-with-new-odoo20-staging-api-key",
      "transport": "json2",
      "json2_database_header": true
    }
  }
}
